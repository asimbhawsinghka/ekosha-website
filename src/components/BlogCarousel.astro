---
// Homepage blog carousel. Shows the 3 most-read articles (by PostHog pageviews
// over the last 90 days) when that data is available, topping up with the
// latest posts if fewer than 3 articles have traffic yet. Falls back to
// latest-3-by-date with no special casing when PostHog data isn't available at
// all (no build-time API key, network/query failure) — see popularPosts.ts.
import { getCollection, type CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { fetchPopularBlogSlugs } from '../lib/popularPosts';

const CARD_COUNT = 3;

const allPosts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

let posts: CollectionEntry<'blog'>[] = allPosts.slice(0, CARD_COUNT);
let heading = 'From the eKosha Blog';
let subheading =
  'Practical, calm guidance on organising your family’s finances — so nothing important is lost when it matters most.';

if (allPosts.length > 0) {
  const popularSlugs = await fetchPopularBlogSlugs();
  if (popularSlugs.length > 0) {
    const bySlug = new Map(allPosts.map((p) => [p.slug, p]));
    const popular = popularSlugs
      .map((slug) => bySlug.get(slug))
      .filter((p): p is CollectionEntry<'blog'> => Boolean(p));

    if (popular.length > 0) {
      const seen = new Set(popular.map((p) => p.slug));
      const filler = allPosts.filter((p) => !seen.has(p.slug));
      posts = [...popular, ...filler].slice(0, CARD_COUNT);
      heading = 'Most Read on the eKosha Blog';
      subheading = 'The articles families like yours are reading right now — real questions, answered plainly.';
    }
  }
}

const dateFmt = (d: Date) =>
  new Intl.DateTimeFormat('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }).format(d);
---
{posts.length > 0 && (
  <section id="blog" class="bg-white py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-5">
        <h2 class="text-3xl sm:text-4xl font-extrabold text-brand-navy mb-4 tracking-tight">
          {heading}
        </h2>
        <p class="text-brand-muted max-w-2xl mx-auto text-lg">
          {subheading}
        </p>
      </div>
      <!-- Gold rule -->
      <div class="flex justify-center mb-14">
        <div class="w-14 h-1 bg-brand-gold rounded-full"></div>
      </div>

      <div class="grid sm:grid-cols-2 md:grid-cols-3 gap-6">
        {posts.map((post) => (
          <a
            href={`/blog/${post.slug}`}
            data-cta={`homepage_blog_${post.slug}`}
            class="group block rounded-2xl overflow-hidden border border-brand-navy/10 shadow-sm hover:shadow-md hover:border-brand-gold/40 transition-all duration-200 bg-white"
          >
            <Image
              src={post.data.heroImage}
              alt={post.data.heroImageAlt}
              widths={[400, 800]}
              sizes="(max-width: 640px) 100vw, 400px"
              class="w-full aspect-[1200/630] object-cover"
            />
            <div class="p-6">
              <div class="flex flex-wrap gap-2 mb-3">
                {post.data.tags.slice(0, 2).map((t) => (
                  <span class="text-xs font-semibold uppercase tracking-wide text-brand-navy bg-brand-gold/20 border border-brand-gold/30 rounded-full px-2.5 py-0.5">{t}</span>
                ))}
              </div>
              <h3 class="text-lg font-bold text-brand-navy mb-2 group-hover:text-brand-gold transition-colors">{post.data.title}</h3>
              <p class="text-brand-muted text-sm leading-relaxed mb-4 line-clamp-3">{post.data.description}</p>
              <p class="text-xs text-brand-muted">{dateFmt(post.data.pubDate)}</p>
            </div>
          </a>
        ))}
      </div>

      <div class="text-center mt-12">
        <a
          href="/blog"
          data-cta="homepage_blog_view_all"
          class="inline-flex items-center gap-2 text-brand-navy font-semibold hover:text-brand-gold transition-colors"
        >
          Read more on the eKosha Blog
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>
    </div>
  </section>
)}
