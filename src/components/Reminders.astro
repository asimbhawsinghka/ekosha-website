---
// Renewal reminders — the "Upcoming renewals" feature in the app. Copy is kept
// to what ships: owners get reminders 7, 3, 1 days before and on the due day;
// one short daily summary push (it never names the asset); the in-app inbox is
// always on; push/email are per-category preferences; reminders are on the Free plan.
const useCases = [
  {
    icon: '🛡️',
    title: 'Insurance premium due',
    body: 'Health and life premiums come around once a year and are easy to miss. A missed premium can mean a lapsed policy — usually discovered only when a claim is needed.',
  },
  {
    icon: '📅',
    title: 'Policy expiry or maturity',
    body: 'Know when a policy needs renewing, or when a life policy matures, so the money does not sit unclaimed.',
  },
  {
    icon: '🏦',
    title: 'Fixed deposit maturity',
    body: 'Decide whether to renew or withdraw while you still have options — not after the bank has auto-renewed at a lower rate.',
  },
  {
    icon: '🌱',
    title: 'PPF, provident fund & small savings',
    body: 'Long-term accounts mature quietly, years after they were opened. A reminder keeps them from being forgotten.',
  },
  {
    icon: '👨‍👩‍👧',
    title: 'Shared with a co-owner',
    body: 'Every co-owner gets the reminder. Anyone can mute an entry for themselves without switching it off for the rest of the family.',
  },
];

const steps = [
  { when: '7 days before', note: 'Time to arrange the payment or compare options.' },
  { when: '3 days before', note: 'A gentle second reminder.' },
  { when: '1 day before', note: 'Last chance to act without a rush.' },
  { when: 'On the due day', note: 'So nothing slips by unnoticed.' },
];
---
<section id="reminders" class="bg-brand-navy py-24">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-5">
      <p class="text-brand-gold text-sm font-bold tracking-widest uppercase mb-3">Renewal reminders</p>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-white mb-4 tracking-tight">
        A policy should never lapse by accident.
      </h2>
      <p class="text-white/65 max-w-2xl mx-auto text-lg">
        Add a renewal or maturity date once. eKosha reminds you before it arrives, shows
        everything coming up in one place, and keeps anything overdue in view until you deal with it.
      </p>
    </div>
    <!-- Gold rule -->
    <div class="flex justify-center mb-14">
      <div class="w-14 h-1 bg-brand-gold rounded-full"></div>
    </div>

    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-start">

      <!-- Left: use cases -->
      <div>
        <h3 class="text-white font-bold text-xl mb-5">When a reminder helps</h3>
        <ul class="space-y-4">
          {useCases.map(u => (
            <li class="flex gap-4 bg-white/5 border border-white/10 rounded-2xl p-5">
              <span class="w-11 h-11 shrink-0 rounded-xl bg-brand-gold/15 border border-brand-gold/30 flex items-center justify-center text-xl" aria-hidden="true">{u.icon}</span>
              <div>
                <h4 class="text-white font-semibold mb-1">{u.title}</h4>
                <p class="text-white/65 text-sm leading-relaxed">{u.body}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>

      <!-- Right: what it looks like -->
      <div class="space-y-6">
        <!-- Notification mock -->
        <div class="bg-white rounded-2xl shadow-xl p-5 flex gap-3.5 items-start">
          <div class="w-10 h-10 shrink-0 rounded-xl bg-brand-navy flex items-center justify-center" aria-hidden="true">
            <span class="text-brand-gold text-lg">🔔</span>
          </div>
          <div class="min-w-0">
            <div class="flex items-center justify-between gap-3 mb-0.5">
              <p class="text-sm font-bold text-brand-navy">Renewal Reminders</p>
              <p class="text-xs text-brand-muted shrink-0">8:00 am</p>
            </div>
            <p class="text-sm text-brand-text leading-snug">3 renewals are coming up — the first is due tomorrow.</p>
            <p class="text-xs text-brand-muted mt-1.5">One short summary a day, however many renewals are due. It never shows account details on your lock screen.</p>
          </div>
        </div>

        <!-- Upcoming renewals page mock -->
        <div class="bg-white rounded-2xl shadow-xl overflow-hidden">
          <div class="bg-brand-bg px-5 py-3.5 border-b border-brand-navy/10 flex items-center justify-between">
            <p class="text-sm font-bold text-brand-navy">Upcoming renewals</p>
            <span class="text-xs font-semibold text-brand-muted">Tap a row to expand</span>
          </div>
          <div class="px-5 py-4 space-y-4">
            <div>
              <p class="text-xs font-bold text-red-700 uppercase tracking-wide mb-2">Overdue</p>
              <div class="flex items-center justify-between rounded-xl border border-red-200 bg-red-50/60 px-4 py-3">
                <div>
                  <p class="text-sm font-semibold text-brand-text">Health insurance</p>
                  <p class="text-xs text-brand-muted">Premium due</p>
                </div>
                <p class="text-xs font-semibold text-red-700">3 days overdue</p>
              </div>
            </div>
            <div>
              <p class="text-xs font-bold text-brand-navy uppercase tracking-wide mb-2">This week</p>
              <div class="flex items-center justify-between rounded-xl border border-brand-navy/10 px-4 py-3">
                <div>
                  <p class="text-sm font-semibold text-brand-text">Fixed deposit</p>
                  <p class="text-xs text-brand-muted">Matures</p>
                </div>
                <p class="text-xs font-semibold text-brand-navy">Tomorrow</p>
              </div>
            </div>
            <div>
              <p class="text-xs font-bold text-brand-navy uppercase tracking-wide mb-2">Next 30 days</p>
              <div class="flex items-center justify-between rounded-xl border border-brand-navy/10 px-4 py-3">
                <div>
                  <p class="text-sm font-semibold text-brand-text">Life insurance</p>
                  <p class="text-xs text-brand-muted">Premium due</p>
                </div>
                <p class="text-xs font-semibold text-brand-navy">In 21 days</p>
              </div>
            </div>
          </div>
          <div class="px-5 py-3.5 bg-brand-bg border-t border-brand-navy/10 flex flex-wrap gap-2 text-xs font-semibold text-brand-navy">
            <span class="px-3 py-1.5 rounded-full bg-white border border-brand-navy/15">Update date</span>
            <span class="px-3 py-1.5 rounded-full bg-white border border-brand-navy/15">Mute reminders</span>
            <span class="px-3 py-1.5 rounded-full bg-white border border-brand-navy/15">Edit</span>
          </div>
        </div>

        <!-- Cadence -->
        <div class="bg-white/5 border border-white/10 rounded-2xl p-5">
          <h3 class="text-white font-bold mb-3">Reminded at the right moments</h3>
          <ol class="grid sm:grid-cols-2 gap-x-6 gap-y-3">
            {steps.map(s => (
              <li class="flex gap-2.5 items-start">
                <span class="mt-1.5 w-2 h-2 rounded-full bg-brand-gold shrink-0" aria-hidden="true"></span>
                <p class="text-sm text-white/65 leading-snug"><span class="font-semibold text-white">{s.when}.</span> {s.note}</p>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </div>

    <!-- Reassurance row -->
    <div class="mt-14 grid sm:grid-cols-3 gap-6 max-w-5xl mx-auto text-center">
      <div>
        <p class="text-white font-semibold mb-1">Renewed it? Two taps.</p>
        <p class="text-white/65 text-sm leading-relaxed">Update the date and next year's reminder is already set.</p>
      </div>
      <div>
        <p class="text-white font-semibold mb-1">You choose how to be told</p>
        <p class="text-white/65 text-sm leading-relaxed">Push and email are switchable by category. The in-app inbox always keeps a record.</p>
      </div>
      <div>
        <p class="text-white font-semibold mb-1">Included on the Free plan</p>
        <p class="text-white/65 text-sm leading-relaxed">Reminders are never behind a paywall.</p>
      </div>
    </div>

    <div class="text-center mt-12">
      <a
        href="/invite/"
        data-cta="reminders_get_started"
        class="inline-flex items-center justify-center bg-brand-gold text-brand-navy font-bold px-7 py-3.5 rounded-xl hover:bg-opacity-90 transition-all shadow-lg text-base"
      >
        Set up your first reminder — it's free
      </a>
    </div>
  </div>
</section>
