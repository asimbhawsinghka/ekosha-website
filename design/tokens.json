  "status": {
    "fine": {
      "tone": "success",
      "icon": "check",
      "label": "On track"
    },
    "upcoming": {
      "tone": "info",
      "icon": "calendar",
      "label": "Due in N days"
    },
    "dueSoon": {
      "tone": "attention",
      "icon": "clock",
      "label": "Due soon / Due today"
    },
    "overdue": {
      "tone": "attentionStrong",
      "icon": "alert-circle",
      "label": "Overdue by N days"
    },
    "locked": {
      "tone": "neutral",
      "icon": "lock",
      "label": "Locked on Free plan"
    },
    "shared": {
      "tone": "neutral",
      "icon": "people",
      "label": "Shared with N"
    }
  },
  "typography": {
    "fontFamily": {
      "latin": "Inter",
      "devanagari": "Noto Sans Devanagari",
      "features": [
        "tnum"
      ]
    },
    "devanagariLineHeightMultiplier": 1.1,
    "textScaleMax": 2.0,
    "displayHeadlineScaleClamp": 1.6,
    "scale": {
      "display": {
        "size": 36,
        "line": 40,
        "weight": 800,
        "tracking": -0.02
      },
      "headline": {
        "size": 28,
        "line": 34,
        "weight": 800,
        "tracking": -0.015
      },
      "titleL": {
        "size": 22,
        "line": 28,
        "weight": 700,
        "tracking": -0.01
      },
      "titleM": {
        "size": 18,
        "line": 24,
        "weight": 600,
        "tracking": -0.005
      },
      "titleS": {
        "size": 16,
        "line": 22,
        "weight": 600,
        "tracking": 0
      },
      "bodyL": {
        "size": 16,
        "line": 24,
        "weight": 400,
        "tracking": 0
      },
      "bodyM": {
        "size": 14,
        "line": 20,
        "weight": 400,
        "tracking": 0
      },
      "bodyS": {
        "size": 12,
        "line": 16,
        "weight": 400,
        "tracking": 0.01
      },
      "labelL": {
        "size": 14,
        "line": 20,
        "weight": 600,
        "tracking": 0
      },
      "labelS": {
        "size": 12,
        "line": 16,
        "weight": 600,
        "tracking": 0.01
      },
      "eyebrow": {
        "size": 12,
        "line": 16,
        "weight": 700,
        "tracking": 0.08,
        "uppercase": true
      }
    }
  },
  "spacing": {
    "s1": 4,
    "s2": 8,
    "s3": 12,
    "s4": 16,
    "s5": 24,
    "s6": 32,
    "s7": 48,
    "s8": 64,
    "hairline": 2
  },
  "pageMargin": {
    "compact": 16,
    "medium": 24,
    "expanded": 32
  },
  "radius": {
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 24,
    "dialog": 20,
    "full": 9999
  },
  "elevation": {
    "level0": {
      "border": "1px line",
      "shadow": "none"
    },
    "level1": {
      "shadow": "0 4 16 rgba(14,34,64,0.10)"
    },
    "level2": {
      "shadow": "0 12 32 rgba(14,34,64,0.18)",
      "scrim": "rgba(14,34,64,0.40)"
    }
  },
  "motion": {
    "fast": {
      "ms": 120,
      "curve": [
        0,
        0,
        0.2,
        1
      ]
    },
    "base": {
      "ms": 200,
      "curve": [
        0.215,
        0.61,
        0.355,
        1
      ]
    },
    "slow": {
      "ms": 320,
      "curve": [
        0.05,
        0.7,
        0.1,
        1
      ]
    },
    "moment": {
      "ms": 600,
      "curve": [
        0.4,
        0,
        0.2,
        1
      ]
    },
    "pageRisePx": 8,
    "skeletonShimmerMs": 1200,
    "skeletonThresholdMs": 300
  },
  "breakpoints": {
    "compact": 0,
    "medium": 600,
    "expanded": 1024,
    "paneMinContentWidth": 840
  },
  "layout": {
    "listPaneMin": 360,
    "listPaneMax": 420,
    "formMaxWidth": 640,
    "readingMeasureCh": 65,
